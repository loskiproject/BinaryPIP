# Supabase — copy from your Supabase project settings
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── PayHero M-Pesa ──────────────────────────────────────────────────────────
# These go in Supabase Dashboard → Edge Functions → Secrets (NOT in this file)
#
# PAYHERO_BASIC_AUTH_TOKEN  = Basic <base64 token from PayHero dashboard>
# PAYHERO_CHANNEL_ID        = <numeric channel ID from PayHero → Payment Channels>
# PAYHERO_CALLBACK_URL      = https://your-project.supabase.co/functions/v1/mpesa-callback
# APP_ORIGIN                = https://your-app.vercel.app
