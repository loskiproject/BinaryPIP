# Supabase — copy from your Supabase project settings
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── UpesiPay M-Pesa Integration (RECOMMENDED) ──────────────────────────────
# Add these secrets in Supabase Dashboard → Edge Functions → Secrets:
#
# UPESIPAY_API_KEY      = <Your UpesiPay API Key / Bearer Token>
# UPESIPAY_APP_KEY      = <Your UpesiPay App Key / Merchant ID (optional if required)>
# UPESIPAY_CALLBACK_URL = https://<your-project-ref>.supabase.co/functions/v1/mpesa-callback
# APP_ORIGIN            = https://your-app.vercel.app
#
# ─── PayHero M-Pesa Integration (ALTERNATIVE / FALLBACK) ────────────────────
# PAYHERO_BASIC_AUTH_TOKEN  = Basic <base64 token from PayHero dashboard>
# PAYHERO_CHANNEL_ID        = <numeric channel ID from PayHero → Payment Channels>
# PAYHERO_CALLBACK_URL      = https://your-project.supabase.co/functions/v1/mpesa-callback

